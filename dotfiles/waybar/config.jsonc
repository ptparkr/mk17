{
  "layer": "top",
  "position": "top",
  "mode": "dock",
  "reload_style_on_change": true,
  "gtk-layer-shell": true,
  "height": 27,

  // <<--< Positions >-->>

  "modules-left": [
    "hyprland/workspaces",  // workspaces
    "custom/cpuinfo",       // temperature
    "cpu",                  // cpu
    "memory",               // memory
    "hyprland/window"       // window title
  ],

  "modules-center": [
    "clock#time",           // time
    "clock#date",           // date
    "idle_inhibitor"        // idle inhibitor
  ],

  "modules-right": [
    "mpris",                 // media info
    "wireplumber",           // output device
    "backlight",             // brightness
    "bluetooth",             // bluetooth
    "network",               // network
    "battery",               // battery
    "power-profiles-daemon", // power profiles
    "tray"                   // system tray
  ],

  // <<--< Modules >-->>

  "hyprland/workspaces": {
    "on-scroll-up": "hyprctl dispatch workspace -1",
    "on-scroll-down": "hyprctl dispatch workspace +1",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },

  "hyprland/window": {
    "format": "{}",
    "tooltip": false,
    "min-length": 5,
    "max-length": 30,

"rewrite": {
      // Desktop
      "": 
        "<span foreground='#89b4fa'> </span> Hyprland",

      // Terminal
      "~": "  Terminal",
      "zsh": "  Terminal",
      "kitty": "  Terminal",     
      "Alacritty": "  Terminal",
       "vedhan@mk17:~": "  Terminal",
            
      "tmux(.*)": 
        "<span foreground='#a6e3a1'> </span> Tmux",

      // Browser

      "(.*)Mozilla Firefox": 
        "<span foreground='#f38ba8'>󰈹 </span> Firefox",
      "(.*) — Mozilla Firefox": 
        "<span foreground='#f38ba8'>󰈹 </span> $1",

      "(.*)Zen Browser": 
        "<span foreground='#fab387'>󰺕 </span> Zen Browser",
      "(.*) — Zen Browser": 
        "<span foreground='#fab387'>󰺕 </span> $1",
        
        "(.*) - Helium": "<span foreground='#60B5FF'> </span> $1",

      // Development

      "(.*) - Visual Studio Code": 
        "<span foreground='#89b4fa'>󰨞 </span> $1",
      "(.*)Visual Studio Code": 
        "<span foreground='#89b4fa'>󰨞 </span> Visual Studio Code",

            "(.*)Cursor": 
        "<span foreground='#aaaaaa'> </span> Cursor",
        
        "(.*)OpenCode": 
        "<span foreground='#aaaaaa'> </span> OpenCode",
        
        "OC (.*)": 
        "<span foreground='#aaaaaa'> </span> OpenCode",
        
      "nvim": 
        "<span foreground='#a6e3a1'> </span> Neovim",
      "nvim (.*)": 
        "<span foreground='#a6e3a1'> </span> $1",

      "vim": 
        "<span foreground='#a6e3a1'> </span> Vim",
      "vim (.*)": 
        "<span foreground='#a6e3a1'> </span> $1",

      // Essential

      "(.*)Spotify": 
        "<span foreground='#a6e3a1'> </span> Spotify",
      "(.*)Spotify Premium": 
        "<span foreground='#a6e3a1'> </span> Spotify Premium",

      "OBS(.*)": 
        "<span foreground='#a6adc8'> </span> OBS Studio",

      "VLC media player": 
        "<span foreground='#fab387'>󰕼 </span> VLC Media Player",
      "(.*) - VLC media player": 
        "<span foreground='#fab387'>󰕼 </span> $1",

      "(.*) - mpv": 
        "<span foreground='#cba6f7'> </span> $1",
        
        "(.*) - Thunar": 
        "<span foreground='#a6adc8'> </span> Thunar",
        
        "Yazi(.*)": 
        "<span foreground='#a6adc8'> </span> Yazi",
        
        
        "Home(.*)": 
        "<span foreground='#aaaaaa'>󰅟 </span> Obsidian",
        
        "Proton VPN(.*)": 
        "<span foreground='#aaaaaa'>󰒃 </span> Proton VPN",
        
        "Foliate(.*)": 
        "<span foreground='#f38ba8'>󰂺 </span> Foliate",

      "qView": "  qView",

      "(.*).jpg": "  $1.jpg",
      "(.*).png": "  $1.png",
      "(.*).svg": "  $1.svg",

      // Social

      "vesktop": 
        "<span foreground='#89b4fa'> </span> Discord",

      "• Discord(.*)": "Discord$1",
      "(.*)Discord(.*)": 
        "<span foreground='#89b4fa'> </span> $1Discord$2",

      // Documents

      "ONLYOFFICE": 
        "<span foreground='#f38ba8'> </span> OnlyOffice",

      "(.*).docx": 
        "<span foreground='#89b4fa'> </span> $1.docx",
      "(.*).xlsx": 
        "<span foreground='#a6e3a1'> </span> $1.xlsx",
      "(.*).pptx": 
        "<span foreground='#fab387'> </span> $1.pptx",
      "(.*).pdf": 
        "<span foreground='#f38ba8'> </span> $1.pdf",

      // System
      "Authenticate": "  Authenticate"
    }
  },


  "custom/cpuinfo": {
    "exec": "~/.config/waybar/scripts/cpu-temp.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 5,
    "min-length": 5,
    "max-length": 10
  },

  "memory": {
    "states": {
      "warning": 70,
      "critical": 85
    },
    "format": "󰘚 {percentage}%",
    "format-critical": "󰀦 {percentage}%",
    "tooltip": false,
    "interval": 5,
    "min-length": 5,
    "max-length": 5
  },

  "cpu": {
    "format": "󰻠 {usage}%",
    "tooltip": false,
    "interval": 5,
    "min-length": 5,
    "max-length": 5
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰈈",
      "deactivated": "󰈉 "
    },
    "tooltip-format-activated": "Presentation Mode",
    "tooltip-format-deactivated": "Idle Mode",
    "start-activated": false
  },

  "clock#time": {
    "format": "󱑒 {:%I:%M %p}",
    "tooltip": false,
    "tooltip-format": "Standard Time: {:%I:%M %p}"
  },

  "clock#date": {
    "format": "󰨳 {:%m-%d}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 6,
      "on-click-right": "mode",
      "format": {
        "months":   "<span color='#b4befe'><b>{}</b></span>",
        "weekdays": "<span color='#a6adc8' font='7'>{}</span>",
        "today":    "<span color='#f38ba8'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click": "mode",
      "on-click-right": "mode"
    }
  },

  "network": {
    "on-click": "kitty --title '󰤨  Network Manager TUI' bash -c nmtui",
    "format": "{ifname}",
    "format-wifi": "󰤟 {signalStrength}%",
    "format-ethernet": "󰊗 {ipaddr}/{cidr}",
    "format-disconnected": "󰖪 0%",
    "tooltip-format": "{essid} {ifname} via {gwaddr} 󰊗",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) 󰤟",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "Disconnected"
  },

  "bluetooth": {
    "format": "󰂚",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱",
    "tooltip-format": "{num_connections} connected",
    "tooltip-format-disabled": "Bluetooth Disabled",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": ":: {device_alias}: 󱊣 {device_battery_percentage}%",
    "on-click": "blueman-manager",
    "interval": 1,
    "min-length": 1,
    "max-length": 1
  },

  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "{status_icon} {title}",

    "player-icons": {
      "default": "󰝚 ",
      "spotify": "<span foreground='#a6e3a1'>󰓇 </span>",
      "firefox": "<span foreground='#f38ba8'>󰗃 </span>"
    },
    "status-icons": {
      "paused": "<span color='#b4befe'>\u200A\u200A󰏤\u2009\u2009</span>"
    },

    "tooltip-format": "Playing: {title} - {artist}",
    "tooltip-format-paused": "Paused: {title} - {artist}",
    "min-length": 5,
    "max-length": 40
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 {volume}%",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
      "headphone": "󰋋",
      "headset": "󰋋"
    },
    
    "tooltip-format": "Device: {desc}",
    "on-click": "~/.config/waybar/scripts/volume-control.sh -o m",
    "on-click-middle": "bash -lc 'pavucontrol'",
    "on-click-right": "bash -lc 'pavucontrol'",
    "on-scroll-up": "~/.config/waybar/scripts/volume-control.sh -o i",
    "on-scroll-down": "~/.config/waybar/scripts/volume-control.sh -o d",
    "min-length": 5,
    "max-length": 6
  },

  "backlight": {
    "format": "󰖨 {percent}%",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
    "tooltip": false,
    "on-scroll-up": "~/.config/waybar/scripts/brightness-control.sh -o i",
    "on-scroll-down": "~/.config/waybar/scripts/brightness-control.sh -o d",
    "min-length": 5,
    "max-length": 5
  },

  "battery": {
    "states": {
      "warning": 40,
      "critical": 30
    },
    "format": "{icon} {capacity}%",
    "format-icons": ["󰂎", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "tooltip-format": "Discharging: {time}",
    "tooltip-format-charging": "Charging: {time}",
    "interval": 1,
    "min-length": 5,
    "max-length": 6
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "power-saver": "",
      "balanced":    "~",
      "performance": ""
    },
    "tooltip-format": "Profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "interval": 5,
    "min-length": 1,
    "max-length": 2
  },

  "tray": {
    "icon-size": 18,
    "spacing": 10,
    "show-passive-items": true
  }
}
