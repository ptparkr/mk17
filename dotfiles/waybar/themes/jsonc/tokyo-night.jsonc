{
  "layer": "top",
  "position": "top",
  "mode": "dock",
  "gtk-layer-shell": true,
  "height": 32,

  "modules-left": ["hyprland/workspaces", "cpu", "memory"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["clock", "mpris", "pulseaudio", "battery", "tray"],

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "①", "2": "②", "3": "③", "4": "④", "5": "⑤",
      "6": "⑥", "7": "⑦", "8": "⑧", "9": "⑨", "10": "⑩"
    }
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 40,
    "separate-outputs": true,
    "rewrite": {
      "": "Desktop",
      "kitty": "Terminal",
      "zsh": "Terminal",
      "~": "Terminal",
      "nvim": "Neovim",
      "vim": "Vim",
      ".*Firefox": "Firefox",
      ".*Chrome": "Chrome",
      ".*Brave": "Brave",
      ".*Code": "VSCode",
      "Spotify": "Spotify",
      "Discord": "Discord",
      ".*": ""
    }
  },

  "cpu": {
    "format": "CPU {usage}%",
    "interval": 10,
    "min-length": 6
  },

  "memory": {
    "format": "RAM {percentage}%",
    "tooltip-format": "{used}GB / {total}GB",
    "interval": 10,
    "min-length": 7
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A, %d %b}"
  },

  "mpris": {
    "format": "{player_icon} {status_icon} {artist} - {title}",
    "format-paused": "{player_icon} ⏸ {artist} - {title}",
    "player-icons": {
      "default": "▶",
      "spotify": "🎵",
      "firefox": "🌐"
    },
    "status-icons": {
      "playing": "▶",
      "paused": "⏸"
    },
    "min-length": 15,
    "max-length": 30
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "🔇",
    "format-icons": {
      "default": ["🔈", "🔉", "🔊"],
      "headphone": "🎧"
    },
    "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_SINK@ 5%-"
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "⚡ {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰃠"],
    "tooltip-format": "{time}"
  },

  "tray": {
    "icon-size": 14,
    "spacing": 4
  }
}